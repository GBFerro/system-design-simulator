{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api *merge*)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/sensors/**)",
      "Edit(/scripts/**)",
      "Edit(/lefthook.yml)",
      "Edit(/lefthook-local.yml)",
      "Edit(/.lefthook-local/**)",
      "Edit(/.lefthook/**)",
      "Edit(/factory.config.sh)",
      "Edit(/.github/workflows/**)"
    ]
  },
  "env": {
    "LEFTHOOK_OUTPUT": "failure"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/sensors/block-protected-branch.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/sensors/block-hook-bypass.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/sensors/block-shell-write-to-tracked.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/sensors/require-test-first.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/sensors/require-routed-subagent.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/sensors/verify-on-stop.sh\"" }
        ]
      }
    ]
  }
}
